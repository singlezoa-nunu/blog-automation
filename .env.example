# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고, 실제 값을 채워 넣으세요.
# .env 파일 자체는 절대 깃허브에 올리지 않습니다 (이미 .gitignore에 등록되어 있음).

# 1) console.anthropic.com 에서 발급받은 키
ANTHROPIC_API_KEY=

# 2) 구글 클라우드에서 다운로드한 client_secret_....json 파일 안에 있는 값
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3) auth-setup.js 를 각 계정으로 한 번씩 실행하면 얻게 되는 값
GOOGLE_REFRESH_TOKEN_NUNUMISO=
GOOGLE_REFRESH_TOKEN_PERJUNI=

# 4) get-blog-id.js 로 조회한 blogId (숫자로 된 긴 값)
BLOG_ID_NUNUMISO=
BLOG_ID_PERJUNI=

# 5) GitHub 저장소를 만든 뒤 채우세요 (예: wanna/blog-automation)
#    썸네일 이미지를 실제로 보여주기 위해 필요합니다.
#    로컬 테스트 단계에서는 비워둬도 되고, 이 경우 이미지 없이 글만 발행됩니다.
GITHUB_REPO=
GITHUB_BRANCH=main
